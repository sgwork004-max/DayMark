{
  "name": "@daymark/ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:local": "wrangler d1 execute manager-ai --local --file=schema.sql",
    "db:remote": "wrangler d1 execute manager-ai --remote --file=schema.sql"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "wrangler": "^4.27.0"
  }
}
