{
  "expo": {
    "name": "Manager",
    "slug": "daymark-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.daymark.mobile",
      "infoPlist": {
        "NSDocumentsFolderUsageDescription": "Manager stores your notes in iCloud Drive so they sync across devices."
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.co.daymark.mobile"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.co.daymark.mobile"
        ],
        "com.apple.developer.icloud-services": ["CloudDocuments"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141414"
      },
      "package": "co.daymark.mobile"
    },
    "plugins": [
      "expo-file-system"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
